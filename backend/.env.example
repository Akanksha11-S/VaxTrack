# Copy this file to ".env" and edit. Never commit the real .env file.

# Long random string used to sign login tokens.
# Generate one with:  python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=change-me

# Database (SQLite file inside the backend folder by default)
# DATABASE_URL=sqlite:///./vaxtrack.db

# Where uploaded cards are stored, the size limit, and how long files are kept
# UPLOAD_DIR=./storage/uploads
MAX_UPLOAD_MB=10
DOCUMENT_RETENTION_DAYS=30

# Frontend origins allowed to call the API (comma separated)
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Full path to tesseract.exe if it is not found automatically (Windows default shown)
# TESSERACT_CMD=C:\Program Files\Tesseract-OCR\tesseract.exe

# Optional AI simplifier for the Vaccine information page.
# Leave LLM_PROVIDER as "none" to use the built-in rules only.
# Providers: none | anthropic | openai  ("openai" works with any OpenAI-compatible API)
LLM_PROVIDER=none
LLM_API_KEY=
# LLM_MODEL=
# LLM_BASE_URL=


# Optional scheduled email reminders (SMTP). If omitted, in-app reminders still work.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=
REMINDER_CHECK_INTERVAL_SECONDS=21600
